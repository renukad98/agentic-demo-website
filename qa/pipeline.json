{
  "stages": [
    "story", "requirements", "designed", "reviewed", "branch-ready",
    "implemented", "automated", "executed", "published", "in-review", "done"
  ],
  "baseBranch": "main",
  "featureBranchPattern": "feature/<story-key>-<slug>",
  "xrayTestPlanPrefix": "Agentic Demo Website – ",
  "skills": {
    "jira-story-agent": ".agents/skills/01-jira-story-agent/SKILL.md",
    "requirements-analysis-agent": ".agents/skills/02-requirements-analysis-agent/SKILL.md",
    "feature-development-agent": ".agents/skills/03-feature-development-agent/SKILL.md",
    "test-design-agent": ".agents/skills/04-test-design-agent/SKILL.md",
    "test-review-agent": ".agents/skills/05-test-review-agent/SKILL.md",
    "playwright-automation-agent": ".agents/skills/06-playwright-automation-agent/SKILL.md",
    "test-execution-reporting-agent": ".agents/skills/07-test-execution-reporting-agent/SKILL.md",
    "xray-test-publisher-agent": ".agents/skills/08-xray-test-publisher-agent/SKILL.md",
    "github-integration-agent": ".agents/skills/09-github-integration-agent/SKILL.md",
    "qa-orchestrator": ".agents/skills/10-qa-orchestrator/SKILL.md"
  },
  "commands": {
    "qa story": { "skill": "jira-story-agent", "stage": "story" },
    "qa requirements": { "skill": "requirements-analysis-agent", "stage": "requirements" },
    "qa test-design": { "skill": "test-design-agent", "stage": "designed" },
    "qa test-review": { "skill": "test-review-agent", "stage": "reviewed" },
    "qa branch": { "skill": "github-integration-agent", "stage": "branch-ready" },
    "qa implement": { "skill": "feature-development-agent", "stage": "implemented" },
    "qa e2e": { "skill": "playwright-automation-agent", "stage": "automated" },
    "qa run": { "skill": "test-execution-reporting-agent", "stage": "executed" },
    "qa xray": {
      "skill": "xray-test-publisher-agent",
      "stage": "published",
      "manualTestBatch": {
        "scope": "active-reviewed-story",
        "connector": "xray_website",
        "mode": "approval-gated-publishing",
        "approval": "native-mcp-form",
        "planGeneration": "automatic",
        "digestManagement": "internal",
        "duplicateCheck": "required",
        "publishManualTests": true,
        "linkTestsToStory": true,
        "verifyAfterPublish": true,
        "requireHumanApproval": true
      }
    },
    "qa pr": { "skill": "github-integration-agent", "stage": "in-review" },
    "qa close": { "skill": "qa-orchestrator", "stage": "done" },
    "qa status": { "skill": "qa-orchestrator", "readOnly": true },
    "qa summary": { "skill": "qa-orchestrator", "readOnly": true },
    "qa next": { "skill": "qa-orchestrator", "readOnly": false }
  },
  "approvalRequiredFor": [
    "application edits", "dependency changes", "branch creation",
    "browser test execution", "Jira creation", "Jira updates",
    "Xray publication and imports", "staging", "commits", "pushes",
    "pull request creation", "merges", "destructive artifact changes"
  ]
}
